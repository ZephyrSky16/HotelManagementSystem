@model Revelation.Front.Office.Web.ViewModels.MasterDataPageViewModel
@{
    var def = Model.Definition;
    ViewBag.Title = def.Title;
    bool editable = def.Fields.Any();
    bool needsModal = editable || def.HasActive;
}

<div class="page-header">
    <div>
        <h1><i class="fa @def.Icon me-2"></i>@def.Title</h1>
        <div class="text-muted">@def.Description <span class="text-xs">(HotellingSystem &middot; dbo.@def.EntityType.Name)</span></div>
    </div>
    <button class="btn btn-hms-primary btn-sm" id="addRowBtn"><i class="fa fa-plus me-1"></i>Add @def.Singular</button>
</div>

@Html.AntiForgeryToken()

<div class="hms-card">
    <div class="hms-card-body p-2">
        <div class="table-responsive">
            <table class="table hms-table table-hover w-100" id="masterDataTable">
                <thead>
                    <tr>
                        <th>Id</th>
                        @foreach (var f in def.Fields)
                        {
                            <th>@f.Label</th>
                        }
                        @if (def.HasActive)
                        {
                            <th>Status</th>
                        }
                        <th>Created</th>
                        @if (def.HasUpdateAudit)
                        {
                            <th>Last Updated</th>
                        }
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        bool active = row.IsActive != false;
                        var fieldAttributes = string.Concat(def.Fields.Select(f =>
                            " data-field-" + f.Name.ToLowerInvariant() + "=\"" + HttpUtility.HtmlAttributeEncode(row.Values[f.Name] ?? "") + "\""));
                        <tr>
                            <td>@row.Id</td>
                            @foreach (var f in def.Fields)
                            {
                                <td>@row.Values[f.Name]</td>
                            }
                            @if (def.HasActive)
                            {
                                <td data-order="@(active ? 1 : 0)">@Html.Raw(active ? "<span class='status-pill status-success'>Active</span>" : "<span class='status-pill status-slate'>Inactive</span>")</td>
                            }
                            <td data-order="@(row.InsertedDate.HasValue ? row.InsertedDate.Value.ToString("o") : "")">
                                @(row.InsertedDate.HasValue ? row.InsertedDate.Value.ToString("MMM d, yyyy h:mm tt") : "")
                                <div class="text-xs text-muted">@row.InsertedBy</div>
                            </td>
                            @if (def.HasUpdateAudit)
                            {
                                <td data-order="@(row.UpdatedDate.HasValue ? row.UpdatedDate.Value.ToString("o") : "")">
                                    @(row.UpdatedDate.HasValue ? row.UpdatedDate.Value.ToString("MMM d, yyyy h:mm tt") : "")
                                    <div class="text-xs text-muted">@row.UpdatedBy</div>
                                </td>
                            }
                            <td>
                                <div class="dropdown">
                                    <button class="table-action-btn" data-bs-toggle="dropdown"><i class="fa fa-ellipsis-v"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        @if (editable)
                                        {
                                            <li>
                                                <a class="dropdown-item edit-row-btn" href="#" data-id="@row.Id" data-active="@(active ? "true" : "false")"@Html.Raw(fieldAttributes)>
                                                    <i class="fa fa-pencil me-2"></i>Edit
                                                </a>
                                            </li>
                                        }
                                        @if (def.HasActive)
                                        {
                                            <li><a class="dropdown-item toggle-row-btn" href="#" data-id="@row.Id" data-active="@(active ? "false" : "true")"><i class="fa @(active ? "fa-toggle-off" : "fa-toggle-on") me-2"></i>@(active ? "Deactivate" : "Activate")</a></li>
                                        }
                                        <li><a class="dropdown-item text-danger delete-row-btn" href="#" data-id="@row.Id"><i class="fa fa-trash me-2"></i>Delete</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (needsModal)
{
    <div class="modal fade" id="rowFormModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="rowForm">
                    <div class="modal-header"><h5 class="modal-title" id="rowFormTitle">Add @def.Singular</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                        <input type="hidden" id="rfId">
                        <div class="row g-3">
                            @foreach (var f in def.Fields)
                            {
                                <div class="col-12">
                                    <label class="form-label" for="rf_@f.Name">@f.Label@(f.Required ? " *" : "")</label>
                                    <input type="text" class="form-control rf-field" id="rf_@f.Name" name="@f.Name" maxlength="@f.MaxLength" @(f.Required ? "required" : "")>
                                </div>
                            }
                            @if (def.HasActive)
                            {
                                <div class="col-12 form-check ms-1"><input class="form-check-input" type="checkbox" id="rfActive" checked><label class="form-check-label" for="rfActive">Active</label></div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-hms-outline" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-hms-primary">Save @def.Singular</button></div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        window.MasterData = {
            key: '@def.Key',
            singular: '@def.Singular',
            needsModal: @(needsModal ? "true" : "false"),
            urls: { save: '@Url.Action("Save", "MasterData")', setActive: '@Url.Action("SetActive", "MasterData")', remove: '@Url.Action("Delete", "MasterData")' }
        };

        $(function () {
            var md = window.MasterData;
            var token = $('input[name="__RequestVerificationToken"]').val();

            $("#masterDataTable").DataTable({ pageLength: 25, lengthChange: false, order: [[0, "asc"]], columnDefs: [{ orderable: false, targets: -1 }] });

            function post(url, data) {
                data = $.extend({ key: md.key, __RequestVerificationToken: token }, data);
                // Both branches must stay rejected on failure so callers' .done() never fires.
                return $.post(url, data).then(function (r) {
                    if (!r.success) { App.toast(r.message || "Something went wrong.", "error"); return $.Deferred().reject(); }
                    return r;
                }, function (xhr) {
                    App.ajaxError(xhr);
                    return $.Deferred().reject();
                });
            }

            function openForm(title, id, values, active) {
                var form = $("#rowForm")[0];
                form.reset();
                $("#rfId").val(id || "");
                $("#rowFormTitle").text(title);
                $(".rf-field").each(function () { $(this).val(values[this.name.toLowerCase()] || ""); });
                $("#rfActive").prop("checked", active);
                new bootstrap.Modal(document.getElementById("rowFormModal")).show();
            }

            $("#addRowBtn").on("click", function () {
                if (md.needsModal) { openForm("Add " + md.singular, null, {}, true); return; }
                App.confirmAction({ title: "Add a new " + md.singular.toLowerCase() + "?", confirmText: "Add" }).then(function (ok) {
                    if (!ok) { return; }
                    post(md.urls.save, {}).done(function () { App.toast(md.singular + " added."); location.reload(); });
                });
            });

            $(document).on("click", ".edit-row-btn", function (e) {
                e.preventDefault();
                var values = {};
                $.each(this.attributes, function () {
                    if (this.name.indexOf("data-field-") === 0) { values[this.name.substring(11)] = this.value; }
                });
                openForm("Edit " + md.singular + " #" + $(this).data("id"), $(this).data("id"), values, String($(this).data("active")) === "true");
            });

            $("#rowForm").on("submit", function (e) {
                e.preventDefault();
                var data = { id: $("#rfId").val() || null };
                if ($("#rfActive").length) { data.isActive = $("#rfActive").is(":checked"); }
                $(".rf-field").each(function () { data[this.name] = $(this).val().trim(); });
                post(md.urls.save, data).done(function () {
                    App.toast(md.singular + " saved.");
                    bootstrap.Modal.getInstance(document.getElementById("rowFormModal")).hide();
                    location.reload();
                });
            });

            $(document).on("click", ".toggle-row-btn", function (e) {
                e.preventDefault();
                var id = $(this).data("id"), active = String($(this).data("active")) === "true";
                App.confirmAction({ title: (active ? "Activate" : "Deactivate") + " " + md.singular.toLowerCase() + " #" + id + "?", confirmText: "Confirm" }).then(function (ok) {
                    if (!ok) { return; }
                    post(md.urls.setActive, { id: id, active: active }).done(function () { App.toast("Updated."); location.reload(); });
                });
            });

            $(document).on("click", ".delete-row-btn", function (e) {
                e.preventDefault();
                var id = $(this).data("id");
                App.confirmAction({ title: "Delete " + md.singular.toLowerCase() + " #" + id + "?", text: "This permanently removes the row from the database.", confirmText: "Delete", danger: true }).then(function (ok) {
                    if (!ok) { return; }
                    post(md.urls.remove, { id: id }).done(function () { App.toast(md.singular + " deleted."); location.reload(); });
                });
            });
        });
    </script>
}
