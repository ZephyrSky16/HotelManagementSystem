@model Revelation.Front.Office.Web.ViewModels.HousekeepingViewModel
@{
    ViewBag.Title = "Housekeeping";
}

<div class="page-header">
    <div><h1>Housekeeping</h1><div class="text-muted">Cleaning assignments and room housekeeping status, grouped by floor.</div></div>
</div>

<div class="hms-card mb-3">
    <div class="hms-card-header"><h2>Today's Cleaning Assignments</h2></div>
    <div class="hms-card-body p-0">
        <table class="table hms-table mb-0">
            <thead><tr><th>Room</th><th>Status</th><th>Assigned To</th><th>Time</th><th>Action</th></tr></thead>
            <tbody>
                @if (!Model.Assignments.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-3">No pending cleaning assignments. All caught up.</td></tr>
                }
                @foreach (var a in Model.Assignments)
                {
                    <tr>
                        <td><strong>@a.Room.Number</strong><div class="text-xs text-muted">Floor @a.Room.Floor</div></td>
                        <td>@Html.Partial("_StatusPill", a.Room.HousekeepingStatus.ToString())</td>
                        <td>@a.AssignedTo</td>
                        <td>@a.AssignedTime</td>
                        <td><button class="btn btn-sm btn-hms-primary mark-inspected-btn" data-id="@a.Room.Id"><i class="fa fa-check me-1"></i>Mark Inspected</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@foreach (var floorGroup in Model.Rooms.GroupBy(r => r.Floor).OrderBy(g => g.Key))
{
    <div class="hms-card mb-3">
        <div class="hms-card-header"><h2>Floor @floorGroup.Key</h2></div>
        <div class="hms-card-body">
            <div class="row g-2">
                @foreach (var room in floorGroup.OrderBy(r => r.Number))
                {
                    <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                        <div class="hk-room-tile hk-room-item" data-id="@room.Id" data-status="@room.HousekeepingStatus" data-dnd="@room.DoNotDisturb.ToString().ToLower()">
                            <div class="d-flex justify-content-between align-items-start">
                                <span class="room-no">@room.Number</span>
                                @if (room.DoNotDisturb)
                                {
                                    <i class="fa fa-moon text-danger" title="Do Not Disturb"></i>
                                }
                            </div>
                            <div class="text-xs text-muted">@room.RoomType.Name</div>
                            <div class="mt-1">@Html.Partial("_StatusPill", room.HousekeepingStatus.ToString())</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="hms-card mt-3">
    <div class="hms-card-header"><h2>Cleaning History</h2></div>
    <div class="hms-card-body p-0">
        <table class="table hms-table mb-0">
            <thead><tr><th>Room</th><th>Staff</th><th>Date</th><th>Change</th><th>Duration</th></tr></thead>
            <tbody>
                @foreach (var h in Model.History)
                {
                    <tr><td>@h.Room.Number</td><td>@h.Staff</td><td>@h.EntryDate.ToString("MMM d, yyyy")</td><td>@h.FromStatus &rarr; @h.ToStatus</td><td>@h.DurationMinutes min</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="hkUpdateModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Update Room <span id="hkModalRoomNo"></span></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="hkModalRoomId">
                <div class="mb-3"><label class="form-label">Housekeeping Status</label><select class="form-select" id="hkModalStatus"><option>Dirty</option><option>Clean</option><option>Inspected</option><option>Occupied</option></select></div>
                <div class="mb-3"><label class="form-label">Assign Staff</label><select class="form-select" id="hkModalStaff"><option value="">Unassigned</option>@foreach (var s in Model.Staff) { <option>@s</option> }</select></div>
                <div class="form-check"><input class="form-check-input" type="checkbox" id="hkModalDnd"><label class="form-check-label" for="hkModalDnd">Do Not Disturb</label></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-hms-outline" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-hms-primary" id="hkSaveBtn">Save</button></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.HkUrls = { update: '@Url.Action("UpdateRoomHousekeeping")', markInspected: '@Url.Action("MarkInspected")' };
        $(function () {
            $(document).on("click", ".hk-room-item", function () {
                $("#hkModalRoomNo").text($(this).find(".room-no").text());
                $("#hkModalRoomId").val($(this).data("id"));
                $("#hkModalStatus").val($(this).data("status"));
                $("#hkModalDnd").prop("checked", $(this).data("dnd") === true || $(this).data("dnd") === "true");
                new bootstrap.Modal(document.getElementById("hkUpdateModal")).show();
            });
            $("#hkSaveBtn").on("click", function () {
                $.post(window.HkUrls.update, { roomId: $("#hkModalRoomId").val(), status: $("#hkModalStatus").val(), staff: $("#hkModalStaff").val(), doNotDisturb: $("#hkModalDnd").is(":checked") })
                    .done(function () { App.toast("Room housekeeping status updated."); location.reload(); }).fail(App.ajaxError);
            });
            $(document).on("click", ".mark-inspected-btn", function () {
                var id = $(this).data("id");
                $.post(window.HkUrls.markInspected, { roomId: id }).done(function () {
                    App.toast("Room marked Inspected and removed from the cleaning queue.");
                    location.reload();
                }).fail(App.ajaxError);
            });
        });
    </script>
}
