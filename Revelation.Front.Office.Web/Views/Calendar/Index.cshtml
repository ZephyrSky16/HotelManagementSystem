@model Revelation.Front.Office.Web.ViewModels.CalendarIndexViewModel
@{
    ViewBag.Title = "Room Availability Calendar";
}

<div class="page-header">
    <div>
        <h1>Room Availability Calendar</h1>
        <div class="text-muted">Room rack view -- click a reservation to view details, click an open slot to create a booking, or drag a booking to another room.</div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-hms-outline btn-sm" id="todayBtn"><i class="fa fa-calendar"></i> Today</button>
    </div>
</div>

<div class="hms-card mb-3">
    <div class="hms-card-body py-2">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="btn-group btn-group-sm" role="group">
                <button class="btn btn-hms-outline" id="prevBtn"><i class="fa fa-chevron-left"></i></button>
                <button class="btn btn-hms-outline" id="nextBtn"><i class="fa fa-chevron-right"></i></button>
            </div>
            <input type="text" class="form-control form-control-sm" id="jumpDateInput" placeholder="Jump to date" style="width:150px;">

            <div class="btn-group btn-group-sm ms-1" role="group">
                <button class="btn btn-hms-outline active" data-view="day">Daily</button>
                <button class="btn btn-hms-outline" data-view="week">Weekly</button>
                <button class="btn btn-hms-outline" data-view="month">Monthly</button>
            </div>

            <div class="vr mx-1 d-none d-lg-block"></div>

            <select class="form-select form-select-sm" id="filterRoomType" style="width:160px;">
                <option value="">All Room Types</option>
                @foreach (var t in Model.RoomTypes)
                {
                    <option value="@t.Id">@t.Name</option>
                }
            </select>
            <select class="form-select form-select-sm" id="filterFloor" style="width:120px;">
                <option value="">All Floors</option>
                @foreach (var f in Model.Floors)
                {
                    <option value="@f">Floor @f</option>
                }
            </select>
            <select class="form-select form-select-sm" id="filterRoomStatus" style="width:150px;">
                <option value="">All Room Statuses</option>
                <option value="Available">Available</option>
                <option value="Occupied">Occupied</option>
                <option value="Reserved">Reserved</option>
                <option value="Dirty">Dirty</option>
                <option value="Clean">Clean</option>
                <option value="Inspected">Inspected</option>
                <option value="OutOfOrder">Out of Order</option>
                <option value="UnderMaintenance">Under Maintenance</option>
            </select>

            <div class="position-relative flex-grow-1" style="min-width:200px;">
                <input type="search" class="form-control form-control-sm" id="calendarSearchInput" placeholder="Search guest or reservation #...">
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-3 mb-3">
    <span class="text-xs fw-600 text-muted">BOOKING STATUS:</span>
    <span class="legend-item"><span class="legend-swatch" style="background:#8a94a6"></span>Tentative</span>
    <span class="legend-item"><span class="legend-swatch" style="background:#2f6fed"></span>Confirmed</span>
    <span class="legend-item"><span class="legend-swatch" style="background:#1e9e6b"></span>Checked In</span>
    <span class="legend-item"><span class="legend-swatch" style="background:#9aa3af"></span>Checked Out</span>
    <span class="legend-item"><span class="legend-swatch" style="background:#cbd1d8"></span>Cancelled</span>
    <span class="legend-item"><span class="legend-swatch" style="background:#c0392b"></span>No Show</span>
    <span class="text-xs fw-600 text-muted ms-3">ROOM:</span>
    <span class="legend-item"><span class="rack-room-status-dot oor"></span>Out of Order</span>
</div>

<div class="rack-wrapper" id="rackWrapper">
    <table class="rack-table" id="rackTable">
        <thead></thead>
        <tbody></tbody>
    </table>
</div>
<div class="text-muted text-xs mt-2"><span id="roomCountLabel"></span></div>

@* Booking Details Modal *@
<div class="modal fade" id="bookingDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa fa-bookmark me-2"></i>Reservation Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="bookingDetailsBody"></div>
            <div class="modal-footer" id="bookingDetailsFooter"></div>
        </div>
    </div>
</div>

@* Quick New Booking Modal *@
<div class="modal fade" id="quickBookingModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="quickBookingForm">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa fa-plus-circle me-2"></i>New Booking</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border d-flex align-items-center gap-2 py-2">
                        <i class="fa fa-door-closed text-primary"></i>
                        <span>Room <strong id="qbRoomLabel"></strong> &middot; <span id="qbRoomTypeLabel"></span> &middot; <span id="qbRateLabel"></span>/night</span>
                    </div>
                    <input type="hidden" id="qbRoomId">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">Guest Full Name *</label><input type="text" class="form-control" id="qbGuestName" required></div>
                        <div class="col-md-6"><label class="form-label">Contact Number *</label><input type="text" class="form-control" id="qbGuestPhone" required></div>
                        <div class="col-md-4"><label class="form-label">Check-in Date *</label><input type="text" class="form-control" id="qbCheckIn" required></div>
                        <div class="col-md-4"><label class="form-label">Check-out Date *</label><input type="text" class="form-control" id="qbCheckOut" required></div>
                        <div class="col-md-2"><label class="form-label">Adults</label><input type="number" class="form-control" id="qbAdults" min="1" value="1"></div>
                        <div class="col-md-2"><label class="form-label">Children</label><input type="number" class="form-control" id="qbChildren" min="0" value="0"></div>
                        <div class="col-md-4">
                            <label class="form-label">Booking Source</label>
                            <select class="form-select" id="qbSource">
                                <option>WalkIn</option><option>Website</option><option>Phone</option><option>TravelAgency</option><option>OTA</option>
                            </select>
                        </div>
                        <div class="col-md-4"><label class="form-label">Nights</label><input type="text" class="form-control" id="qbNights" readonly></div>
                        <div class="col-md-4"><label class="form-label">Total Amount</label><input type="text" class="form-control fw-600" id="qbTotal" readonly></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-hms-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-hms-primary"><i class="fa fa-check me-1"></i>Create Booking</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.CalendarUrls = {
            getRackData: '@Url.Action("GetRackData", "Calendar")',
            createBooking: '@Url.Action("CreateBooking", "Calendar")',
            moveReservation: '@Url.Action("MoveReservation", "Calendar")',
            checkIn: '@Url.Action("CheckIn", "Calendar")',
            cancelReservation: '@Url.Action("CancelReservation", "Calendar")',
            reservationsIndex: '@Url.Action("Index", "Reservations")',
            checkOutIndex: '@Url.Action("Index", "CheckOut")'
        };
    </script>
    <script src="~/Scripts/calendar.js"></script>
}
