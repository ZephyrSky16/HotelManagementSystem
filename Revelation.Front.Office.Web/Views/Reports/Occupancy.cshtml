@model Revelation.Front.Office.Web.ViewModels.OccupancyReportViewModel
@{
    ViewBag.Title = "Occupancy Report";
    var avgPct = Model.Points.Any() ? Math.Round(Model.Points.Average(p => p.OccupancyPercent), 1) : 0;
    var peak = Model.Points.OrderByDescending(p => p.OccupancyPercent).FirstOrDefault();
    var roomNights = Model.Points.Sum(p => p.RoomsOccupied);
}

<div class="page-header">
    <div><h1>Occupancy Report</h1><div class="text-muted">Daily room occupancy, computed directly from actual reservation records.</div></div>
</div>

@using (Html.BeginForm("Occupancy", "Reports", FormMethod.Get))
{
    <div class="hms-card mb-3">
        <div class="hms-card-body py-2 d-flex gap-2 align-items-center flex-wrap">
            <label class="small text-muted">From</label>
            <input type="date" name="start" class="form-control form-control-sm" style="width:160px;" value="@Model.Start.ToString("yyyy-MM-dd")">
            <label class="small text-muted">To</label>
            <input type="date" name="end" class="form-control form-control-sm" style="width:160px;" value="@Model.End.ToString("yyyy-MM-dd")">
            <button type="submit" class="btn btn-hms-outline btn-sm">Apply</button>
            <div class="flex-grow-1"></div>
            <a class="btn btn-hms-outline btn-sm" href="@Url.Action("ExportOccupancyCsv", new { start = Model.Start.ToString("yyyy-MM-dd"), end = Model.End.ToString("yyyy-MM-dd") })"><i class="fa fa-file-text-o me-1"></i>Export CSV</a>
        </div>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="kpi-card"><div class="kpi-icon" style="background:#e8eef4;color:#1a3a5c;"><i class="fa fa-area-chart"></i></div><div class="kpi-meta"><div class="kpi-value">@avgPct%</div><div class="kpi-label">Average Occupancy</div></div></div></div>
    <div class="col-6 col-md-3"><div class="kpi-card"><div class="kpi-icon" style="background:#e5f6ef;color:#1e9e6b;"><i class="fa fa-arrow-circle-up"></i></div><div class="kpi-meta"><div class="kpi-value">@(peak != null ? peak.OccupancyPercent + "%" : "--")</div><div class="kpi-label">Peak Occupancy</div></div></div></div>
    <div class="col-6 col-md-3"><div class="kpi-card"><div class="kpi-icon" style="background:#e8eef9;color:#2f6fed;"><i class="fa fa-moon-o"></i></div><div class="kpi-meta"><div class="kpi-value">@roomNights</div><div class="kpi-label">Room-Nights Sold</div></div></div></div>
    <div class="col-6 col-md-3"><div class="kpi-card"><div class="kpi-icon" style="background:#fdf3e0;color:#b8860b;"><i class="fa fa-building"></i></div><div class="kpi-meta"><div class="kpi-value">@(Model.Points.Any() ? Model.Points.First().TotalRooms : 0)</div><div class="kpi-label">Total Rooms</div></div></div></div>
</div>

<div class="hms-card mb-3">
    <div class="hms-card-header"><h2>Occupancy Trend</h2></div>
    <div class="hms-card-body"><canvas id="orChart" height="90"></canvas></div>
</div>

<div class="hms-card">
    <div class="hms-card-header"><h2>Occupancy Detail</h2></div>
    <div class="hms-card-body p-0">
        <table class="table hms-table mb-0">
            <thead><tr><th>Date</th><th>Rooms Occupied</th><th>Rooms Available</th><th>Total Rooms</th><th>Occupancy %</th></tr></thead>
            <tbody>
                @foreach (var p in Model.Points)
                {
                    <tr><td>@p.Date.ToString("MMM d, yyyy")</td><td>@p.RoomsOccupied</td><td>@p.RoomsAvailable</td><td>@p.TotalRooms</td><td>@p.OccupancyPercent%</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var labels = [@Html.Raw(string.Join(",", Model.Points.Select(p => "\"" + p.Date.ToString("MMM d") + "\"")))];
            var data = [@string.Join(",", Model.Points.Select(p => p.OccupancyPercent))];
            new Chart(document.getElementById("orChart").getContext("2d"), {
                type: "line",
                data: { labels: labels, datasets: [{ label: "Occupancy %", data: data, borderColor: "#1a3a5c", backgroundColor: "rgba(26,58,92,0.08)", fill: true, tension: 0.3, pointRadius: 2 }] },
                options: { scales: { y: { beginAtZero: true, max: 100 } }, plugins: { legend: { display: false } } }
            });
        });
    </script>
}
