<div class="topbar-left">
    <button type="button" class="sidebar-toggle-btn" id="sidebarToggleBtn" aria-label="Toggle sidebar"><i class="fa fa-bars"></i></button>
    <div class="topbar-search d-none d-md-block">
        <i class="fa fa-search"></i>
        <input type="search" class="form-control" id="globalSearchInput" placeholder="Search guests, reservations, rooms...">
        <div class="list-group shadow-sm" id="globalSearchResults" style="position:absolute; top:42px; left:0; right:0; z-index:1050; display:none; max-height:320px; overflow:auto;"></div>
    </div>
</div>
<div class="topbar-datetime d-none d-lg-block">
    <strong id="topbarClockTime">--:--:--</strong> &middot; <span id="topbarClockDate">@DateTime.Now.ToString("ddd, MMM d, yyyy")</span>
</div>
<div class="topbar-right">
    <div class="dropdown">
        <button class="topbar-icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa fa-bell"></i><span class="badge-dot"></span>
        </button>
        <div class="dropdown-menu dropdown-menu-end p-0" style="width:320px;">
            <div class="px-3 py-2 border-bottom fw-600">Notifications</div>
            <a class="dropdown-item py-2" href="#"><i class="fa fa-door-open text-primary me-2"></i>Room 214 marked Dirty after check-out</a>
            <a class="dropdown-item py-2" href="#"><i class="fa fa-exclamation-triangle text-warning me-2"></i>Maintenance request #MR-1042 is overdue</a>
            <a class="dropdown-item py-2" href="#"><i class="fa fa-calendar-check-o text-success me-2"></i>New reservation confirmed</a>
        </div>
    </div>
    <div class="dropdown">
        <div class="topbar-profile" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="avatar">MS</div>
            <div class="profile-meta"><strong>Mariel Santos</strong><small>Front Desk Supervisor</small></div>
            <i class="fa fa-chevron-down small text-muted d-none d-lg-inline"></i>
        </div>
        <div class="dropdown-menu dropdown-menu-end">
            <a class="dropdown-item" href="#"><i class="fa fa-user me-2"></i>My Profile</a>
            <div class="dropdown-divider"></div>
            <a class="dropdown-item" href="#" id="logoutBtn"><i class="fa fa-sign-out me-2"></i>Logout</a>
        </div>
    </div>
</div>
