<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Harborview Grand PMS</title>

    @Styles.Render("~/Content/css")

    @* DataTables, Flatpickr, SweetAlert2, Select2, and Chart.js are not part of the
       approved NuGet package list for this migration, so (per the architecture note
       in the migration report) they continue to load from CDN unchanged from the
       original static site, rather than adding unlisted package dependencies. *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="app-shell" id="appShell">
        <aside class="app-sidebar">
            @Html.Partial("_Sidebar")
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                @Html.Partial("_TopNavigation")
            </header>

            <main class="page-content">
                @RenderBody()
            </main>
        </div>
    </div>
    <div class="sidebar-backdrop"></div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/app")

    @RenderSection("Scripts", required: false)
</body>
</html>
